DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=telleriq_db
DB_PORT=3306

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to include intent/confidence/tool in API responses (shown in UI with ?debug=1)
TELLERIQ_DEBUG=0

# Flask signed-session secret. Required for shared/deployed environments.
# Local development falls back to a non-production placeholder if unset.
SECRET_KEY=replace-with-a-long-random-local-secret

# Comma-separated browser origins allowed for credentialed CORS (cookies).
# Local frontend POC: http://127.0.0.1:8000 (prefer 127.0.0.1 consistently).
# Never use * when the frontend sends credentials: "include".
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Set to 1 only for HTTPS deployments that require Secure session cookies.
SESSION_COOKIE_SECURE=0

# Flask session SameSite policy. Allowed: Lax (default), Strict, None.
# Local HTTP POC: keep Lax.
# Cross-site HTTPS (Vercel frontend → Render API): set None together with
# SESSION_COOKIE_SECURE=1 (browsers require Secure when SameSite=None).
# Invalid values fall back to Lax.
SESSION_COOKIE_SAMESITE=Lax

# Phase 2 identity gate for /chat and /dashboard/stats.
# Keep 0 so the existing chatbot remains usable without login.
# Enable only together with Phase 3 tenant SQL enforcement.
AUTH_REQUIRED=0

# Phase 3A/3B tenant enforcement.
# Keep 0 so existing chatbot + global dashboard behavior remain unchanged.
# When 1:
#   - MCP execute_safe_sql requires TELLERIQ_TRUSTED_STORE_ID (fail closed)
#   - GET /dashboard/stats requires authenticated g.store_id (HTTP 401 if missing)
TENANCY_ENFORCEMENT=0

# Optional overrides for scripts/seed_phase2_demo_users.py
# DEMO_USER_A_PASSWORD=demo-store1-pass
# DEMO_USER_B_PASSWORD=demo-store2-pass
