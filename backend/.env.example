DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=telleriq_db
DB_PORT=3306

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to include intent/confidence/tool in API responses (shown in UI with ?debug=1)
TELLERIQ_DEBUG=0

# Flask signed-session secret. Required for shared/deployed environments.
# Local development falls back to a non-production placeholder if unset.
SECRET_KEY=replace-with-a-long-random-local-secret

# Phase 2 identity gate for /chat and /dashboard/stats.
# Keep 0 so the existing chatbot remains usable without login.
# Enable only together with Phase 3 tenant SQL enforcement.
AUTH_REQUIRED=0

# Optional overrides for scripts/seed_phase2_demo_users.py
# DEMO_USER_A_PASSWORD=demo-store1-pass
# DEMO_USER_B_PASSWORD=demo-store2-pass
